{
  "realm": "${KEYCLOAK_REALM_NAME}",
  "enabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {
        "name": "manager",
        "description": "Менеджер"
      },
      {
        "name": "superviser",
        "description": "Руководитель"
      },
      {
        "name": "admin",
        "description": "Администратор"
      }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"required\":{},\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "${KEYCLOAK_CLIENT_ID}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${KEYCLOAK_REDIRECT_URI}"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-${KEYCLOAK_CLIENT_ID}",
      "enabled": true,
      "serviceAccountClientId": "${KEYCLOAK_CLIENT_ID}",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users",
          "view-realm"
        ]
      }
    },
    {
      "id": "${APP_ADMIN_ID}",
      "username": "${APP_ADMIN_USERNAME}",
      "email": "${APP_ADMIN_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${APP_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
