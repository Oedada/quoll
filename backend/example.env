SESSION_SECRET_KEY=
# ключ шифрования персональных данных в базе, генерируется так же
PII_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=true
# куда вернуть браузер после входа
POST_LOGIN_REDIRECT_URL=/front
# фоновые процессы: чистка сессий, очередь, сверка с Keycloak
WORKERS_ENABLED=true
SESSION_CLEANUP_INTERVAL_SECONDS=3600
PAUSE_EXPIRY_INTERVAL_SECONDS=30
ORG_QUEUE_INTERVAL_SECONDS=30
RECONCILER_INTERVAL_SECONDS=60
# очередь выгрузок отчётов и чистка их файлов в S3
REPORT_WORKER_INTERVAL_SECONDS=2
REPORT_CLEANUP_INTERVAL_SECONDS=3600
REPORT_RENDER_PROCESSES=2
# пул соединений с базой
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# демо для жюри: эталонный воркфлоу и учётки ролей при старте
DEMO_MODE=false

# интеграции-заглушки: секрет отпечатка email, доступность заглушки, час обмена
