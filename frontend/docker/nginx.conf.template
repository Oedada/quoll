server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # /api и /auth - на backend (как в vite.config.ts для dev-сервера),
    # BACKEND_ORIGIN задаётся переменной окружения контейнера
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /auth/ {
        proxy_pass ${BACKEND_ORIGIN}/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # статика дизайн-системы и ассеты собранного бандла
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location /ds/ {
        try_files $uri =404;
        expires 1h;
    }

    # SPA - все остальные пути отдаём на index.html, роутинг на стороне react-router
    location / {
        try_files $uri /index.html;
    }
}
